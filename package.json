{
  "name": "@jason25417/dsh-session-auto-rename",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Sidebar Session menu: LLM auto-rename weighted toward recent messages, plus a right-click menu on Session rows. · 侧栏会话菜单：LLM 自动重命名（越新的消息权重越高），并支持右键会话呼出菜单。",
  "author": "Jason Tu",
  "homepage": "https://github.com/Jason25417/dsh-session-auto-rename#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason25417/dsh-session-auto-rename.git"
  },
  "bugs": {
    "url": "https://github.com/Jason25417/dsh-session-auto-rename/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "session",
    "rename",
    "title",
    "sidebar",
    "context-menu",
    "llm"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
